<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Portable PDBs are needed for dotnet-coverage to map hits back to source lines -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only used when PERSISTENCE_ENABLED=true: MongoDB stores applications, Kafka carries decision events -->
    <PackageReference Include="Confluent.Kafka" Version="2.6.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.0.0" />
    <!-- Pin transitive dependency of MongoDB.Driver to fix CVE-2026-44302 -->
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

</Project>
